# انسخ هذا الملف إلى .env.local
# قيم supabase start (محلياً) أو من لوحة المشروع (الإنتاج)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# مفتاح الخدمة: للسكربتات الإدارية على جهازك فقط.
# لا يُستخدم في أي كود يصل للمتصفح، ولا يُضاف إلى Vercel في هذه المرحلة.
SUPABASE_SERVICE_ROLE_KEY=

# لسكربت إنشاء المشرف العام (احذفه بعد الاستخدام)
BOOTSTRAP_ADMIN_PASSWORD=
