# انسخ هذا الملف إلى .env.local
# قيم supabase start (محلياً) أو من لوحة المشروع (الإنتاج)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# مفتاح الخدمة: لإنشاء الحسابات وإعادة تعيين كلمات المرور من شاشة المستخدمين.
# يُضاف في Vercel بنوع Secret وبدون البادئة NEXT_PUBLIC_ فلا يصل للمتصفح أبداً.
# يُقرأ فقط في src/lib/supabase/admin.ts المحمي بـ 'server-only'.
SUPABASE_SERVICE_ROLE_KEY=

# لسكربت إنشاء المشرف العام (احذفه بعد الاستخدام)
BOOTSTRAP_ADMIN_PASSWORD=
